<Window x:Class="Klip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Klip.Models"
        Title="Клип"
        Width="940" Height="640"
        MinWidth="740" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize"
        Background="Transparent"
        Foreground="{StaticResource FgBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Closing="OnClosing"
        SourceInitialized="OnSourceInitialized"
        SizeChanged="OnWindowSizeChanged"
        DpiChanged="OnWindowDpiChanged"
        PreviewKeyDown="OnPreviewKeyDown"
        StateChanged="OnStateChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="16"
                      UseAeroCaptionButtons="False"
                      NonClientFrameEdges="None"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Border x:Name="WindowFrame"
                BorderBrush="{StaticResource HairlineBrush}"
                BorderThickness="1"
                Background="Transparent"
                CornerRadius="16"
                ClipToBounds="True">
            <Grid>
                <Image x:Name="WallpaperImage"
                       Stretch="UniformToFill"
                       Visibility="Collapsed"
                       IsHitTestVisible="False">
                    <Image.CacheMode>
                        <BitmapCache RenderAtScale="1" EnableClearType="False" SnapsToDevicePixels="True"/>
                    </Image.CacheMode>
                    <Image.Effect>
                        <BlurEffect x:Name="WallpaperBlur" Radius="0" KernelType="Gaussian" RenderingBias="Performance"/>
                    </Image.Effect>
                </Image>
                <Border x:Name="WallpaperDim"
                        Visibility="Collapsed"
                        IsHitTestVisible="False"/>

                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Grid Grid.Row="0" Margin="14,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource AccentBrush}">
                            <Viewbox Width="12" Height="12">
                                <Path Fill="{StaticResource AccentFgBrush}"
                                      Data="M7,2 H17 A2,2 0 0 1 19,4 V6 H21 A1,1 0 0 1 22,7 V20 A2,2 0 0 1 20,22 H8 A2,2 0 0 1 6,20 V7 A1,1 0 0 1 7,6 H9 V4 A2,2 0 0 1 11,2 Z M11,4 V6 H17 V4 Z M8,8 V20 H20 V8 Z"/>
                            </Viewbox>
                        </Border>
                        <TextBlock Text="Клип" Margin="10,0,0,0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TitleCount"
                                   Text=""
                                   Margin="10,1,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource SubtleBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ChromeButton}" Click="OnOpenTelegram" ToolTip="Telegram @yeet17">
                            <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M23.91,3.79 L20.3,20.84 C20.03,22.05 19.32,22.35 18.31,21.78 L12.81,17.72 L10.16,20.27 C9.87,20.56 9.62,20.81 9.06,20.81 L9.45,15.21 L19.64,6 C20.08,5.61 19.54,5.39 18.96,5.78 L6.37,13.7 L0.95,12 C-0.23,11.63 -0.25,10.82 1.2,10.25 L22.37,2.1 C23.35,1.74 24.21,2.34 23.91,3.79 Z"
                                  Width="20" Height="20" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource ChromeButton}" Click="OnOpenGitHub" ToolTip="Репозиторий на GitHub">
                            <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M12,0.5 C5.37,0.5 0,5.87 0,12.5 C0,17.8 3.44,22.3 8.21,23.89 C8.81,24 9.03,23.63 9.03,23.31 C9.03,23.02 9.02,22.28 9.02,21.29 C5.68,22.02 4.97,19.68 4.97,19.68 C4.42,18.28 3.63,17.91 3.63,17.91 C2.54,17.16 3.72,17.18 3.72,17.18 C4.93,17.27 5.56,18.42 5.56,18.42 C6.63,20.26 8.37,19.73 9.06,19.42 C9.17,18.64 9.48,18.11 9.82,17.81 C7.15,17.5 4.34,16.48 4.34,11.88 C4.34,10.57 4.81,9.5 5.58,8.66 C5.46,8.35 5.04,7.14 5.7,5.49 C5.7,5.49 6.71,5.17 9,6.72 C9.96,6.45 10.98,6.31 12,6.31 C13.02,6.31 14.04,6.45 15,6.72 C17.29,5.17 18.3,5.49 18.3,5.49 C18.96,7.14 18.54,8.35 18.42,8.66 C19.19,9.5 19.66,10.57 19.66,11.88 C19.66,16.49 16.84,17.49 14.16,17.8 C14.59,18.17 14.98,18.9 14.98,20.02 C14.98,21.62 14.97,22.91 14.97,23.31 C14.97,23.63 15.19,24.01 15.8,23.89 C20.56,22.3 24,17.8 24,12.5 C24,5.87 18.63,0.5 12,0.5 Z"
                                  Width="20" Height="20" Stretch="Uniform"/>
                        </Button>
                        <Button Style="{StaticResource ChromeButton}" Click="OnMinimize" ToolTip="Свернуть">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M4,10 H16" Width="20" Height="20" Stretch="None"/>
                        </Button>
                        <Button x:Name="MaxButton" Style="{StaticResource ChromeButton}" Click="OnMaximize" ToolTip="Развернуть">
                            <Path x:Name="MaxIcon"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2"
                                  Data="M5,5 H15 V15 H5 Z" Width="20" Height="20" Stretch="None"/>
                        </Button>
                        <Button Style="{StaticResource CloseButton}" Click="OnCloseClick" ToolTip="Скрыть в трей">
                            <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M5,5 L15,15 M15,5 L5,15" Width="20" Height="20" Stretch="None"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="12,0,12,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="232"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Sidebar -->
                    <Border Grid.Column="0"
                            Background="{StaticResource GlassBrush}"
                            BorderBrush="{StaticResource HairlineBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollViewer x:Name="SideScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <Button x:Name="NavAll" Style="{StaticResource NavButton}" Click="OnNavClick" Tag="all">
                                        <Grid>
                                            <TextBlock Text="Все" HorizontalAlignment="Left"/>
                                            <TextBlock x:Name="CountAll" Text="0" HorizontalAlignment="Right" Foreground="{StaticResource SubtleBrush}" FontSize="12"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="NavPinned" Style="{StaticResource NavButton}" Click="OnNavClick" Tag="pinned">
                                        <Grid>
                                            <StackPanel Orientation="Horizontal">
                                                <Path Width="12" Height="12" Stretch="Uniform" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Data="M12 2 L15 8 L21.5 9 L16.8 13.6 L18 20 L12 16.8 L6 20 L7.2 13.6 L2.5 9 L9 8 Z" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Закреплённые"/>
                                            </StackPanel>
                                            <TextBlock x:Name="CountPinned" Text="0" HorizontalAlignment="Right" Foreground="{StaticResource SubtleBrush}" FontSize="12"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="NavClip" Style="{StaticResource NavButton}" Click="OnNavClick" Tag="clip">
                                        <Grid>
                                            <TextBlock Text="Фрагменты" HorizontalAlignment="Left"/>
                                            <TextBlock x:Name="CountClip" Text="0" HorizontalAlignment="Right" Foreground="{StaticResource SubtleBrush}" FontSize="12"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="NavNote" Style="{StaticResource NavButton}" Click="OnNavClick" Tag="note">
                                        <Grid>
                                            <TextBlock Text="Заметки" HorizontalAlignment="Left"/>
                                            <TextBlock x:Name="CountNote" Text="0" HorizontalAlignment="Right" Foreground="{StaticResource SubtleBrush}" FontSize="12"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="NavCode" Style="{StaticResource NavButton}" Click="OnNavClick" Tag="code">
                                        <Grid>
                                            <TextBlock Text="Код" HorizontalAlignment="Left"/>
                                            <TextBlock x:Name="CountCode" Text="0" HorizontalAlignment="Right" Foreground="{StaticResource SubtleBrush}" FontSize="12"/>
                                        </Grid>
                                    </Button>
                                    <Button x:Name="NavLink" Style="{StaticResource NavButton}" Click="OnNavClick" Tag="link">
                                        <Grid>
                                            <TextBlock Text="Ссылки" HorizontalAlignment="Left"/>
                                            <TextBlock x:Name="CountLink" Text="0" HorizontalAlignment="Right" Foreground="{StaticResource SubtleBrush}" FontSize="12"/>
                                        </Grid>
                                    </Button>

                                    <TextBlock Text="Папки"
                                               Margin="12,16,12,6"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource SubtleBrush}"/>
                                    <ItemsControl x:Name="FolderList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:CollectionItem}">
                                                <Grid Margin="0,1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Click="OnFolderClick">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                        <Setter Property="Tag" Value="active"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <Grid>
                                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,28,0"/>
                                                            <TextBlock Text="{Binding Count}" HorizontalAlignment="Right" Foreground="{StaticResource SubtleBrush}" FontSize="12"/>
                                                        </Grid>
                                                    </Button>
                                                    <Button Grid.Column="1"
                                                            Style="{StaticResource IconButton}"
                                                            Width="28" Height="28"
                                                            Click="OnDeleteFolder"
                                                            ToolTip="Удалить папку">
                                                        <Path Width="11" Height="11" Stretch="Uniform" Stroke="{StaticResource SubtleBrush}" StrokeThickness="1.4"
                                                              Data="M4,6 H20 M9,6 V4 H15 V6 M8,10 V18 M12,10 V18 M16,10 V18 M6,6 L7,20 H17 L18,6"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid Margin="4,6,4,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid>
                                            <TextBox x:Name="FolderNameBox"
                                                     Style="{StaticResource FieldBox}"
                                                     Padding="10,7"
                                                     Height="36"
                                                     VerticalContentAlignment="Center"
                                                     MaxLength="64"
                                                     KeyDown="OnFolderNameKey"/>
                                            <TextBlock x:Name="FolderHint"
                                                       Text="Новая папка"
                                                       Foreground="{StaticResource SubtleBrush}"
                                                       Margin="12,0,0,0"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False"/>
                                        </Grid>
                                        <Button Grid.Column="1"
                                                Style="{StaticResource IconButton}"
                                                Width="36" Height="36"
                                                Margin="4,0,0,0"
                                                Click="OnAddFolder"
                                                ToolTip="Добавить папку">
                                            <Path Width="11" Height="11" Stretch="Uniform" Stroke="{StaticResource FgBrush}" StrokeThickness="1.6"
                                                  Data="M12,5 V19 M5,12 H19"/>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel Grid.Row="1" Margin="4,10,4,4">
                                <CheckBox x:Name="StartupCheck"
                                          Style="{StaticResource GlassCheck}"
                                          Margin="8,0,8,8"
                                          Content="Запускать с Windows"
                                          Checked="OnStartupChanged"
                                          Unchecked="OnStartupChanged"/>
                                <Button x:Name="SettingsButton"
                                        Style="{StaticResource NavButton}"
                                        Click="OnOpenSettings">
                                    <TextBlock Text="Настройки" HorizontalAlignment="Left"/>
                                </Button>
                                <TextBlock x:Name="VersionLabel"
                                           Margin="12,8,8,4"
                                           FontSize="11"
                                           Foreground="{StaticResource SubtleBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Content -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Background="{StaticResource GlassBrush}"
                                BorderBrush="{StaticResource HairlineBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="10"
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#14000000" CornerRadius="12" Padding="10,0" Height="40">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Width="14" Height="14" Margin="2,0,8,0">
                                            <Path Stroke="{StaticResource SubtleBrush}" StrokeThickness="1.8" Fill="Transparent"
                                                  Data="M10,3 A7,7 0 1 1 10,17 A7,7 0 1 1 10,3 Z M15.5,15.5 L20,20"/>
                                        </Viewbox>
                                        <Grid Grid.Column="1">
                                            <TextBlock x:Name="SearchHint"
                                                       Text="Поиск по буферу"
                                                       Foreground="{StaticResource SubtleBrush}"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False"/>
                                            <TextBox x:Name="SearchBox"
                                                     Style="{StaticResource SearchBox}"
                                                     VerticalAlignment="Center"
                                                     TextChanged="OnSearchChanged"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Button Grid.Column="1"
                                        Style="{StaticResource PrimaryButton}"
                                        Margin="10,0,0,0"
                                        Padding="14,0"
                                        Height="40"
                                        Click="OnNewNote"
                                        Content="Запись"/>
                            </Grid>
                        </Border>

                        <Grid x:Name="ClipStage" Grid.Row="1" ClipToBounds="True">
                            <Grid x:Name="ClipPane" RenderTransformOrigin="0.5,0.08">
                            <ListBox x:Name="ClipList"
                                     ItemsSource="{Binding VisibleClips}"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     VirtualizingPanel.ScrollUnit="Pixel"
                                     ScrollViewer.CanContentScroll="True"
                                     MouseDoubleClick="OnClipDoubleClick"
                                     PreviewMouseLeftButtonUp="OnClipClick"
                                     KeyDown="OnListKeyDown">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Копировать" Click="OnCopyMenu"/>
                                        <MenuItem Header="Закрепить" Click="OnPinMenu"/>
                                        <MenuItem Header="Изменить" Click="OnEditMenu"/>
                                        <MenuItem Header="Цвет">
                                            <MenuItem Header="Без метки" Tag="none" Click="OnColorMenu"/>
                                            <MenuItem Header="Небо" Tag="sky" Click="OnColorMenu"/>
                                            <MenuItem Header="Шалфей" Tag="sage" Click="OnColorMenu"/>
                                            <MenuItem Header="Глина" Tag="clay" Click="OnColorMenu"/>
                                            <MenuItem Header="Песок" Tag="sand" Click="OnColorMenu"/>
                                        </MenuItem>
                                        <MenuItem x:Name="FolderMenu" Header="Папка"/>
                                        <Separator/>
                                        <MenuItem Header="Удалить" Click="OnDeleteMenu"/>
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ClipItem}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="3" CornerRadius="2" Background="{Binding MarkBrush}" Margin="0,2,12,2"/>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding DisplayTitle}"
                                                           FontWeight="SemiBold"
                                                           FontSize="13.5"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                    <Border Style="{StaticResource KindChip}">
                                                        <TextBlock Text="{Binding KindLabel}" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding MetaLabel}"
                                                               Margin="10,0,0,0"
                                                               FontSize="11"
                                                               Foreground="{StaticResource SubtleBrush}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Preview}"
                                                           Margin="0,8,8,0"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           MaxHeight="58"
                                                           LineHeight="18">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                                                            <Setter Property="FontSize" Value="13"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCode}" Value="True">
                                                                    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
                                                                    <Setter Property="FontSize" Value="12"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                                <Button Style="{StaticResource IconButton}" Click="OnPinClick" ToolTip="Закрепить">
                                                    <Path Width="12" Height="12" Stretch="Uniform"
                                                          Stroke="{StaticResource MutedBrush}"
                                                          StrokeThickness="1.2"
                                                          Data="M12 2 L15 8 L21.5 9 L16.8 13.6 L18 20 L12 16.8 L6 20 L7.2 13.6 L2.5 9 L9 8 Z">
                                                        <Path.Style>
                                                            <Style TargetType="Path">
                                                                <Setter Property="Fill" Value="Transparent"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Pinned}" Value="True">
                                                                        <Setter Property="Fill" Value="{StaticResource AccentBrush}"/>
                                                                        <Setter Property="Stroke" Value="{StaticResource AccentBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Path.Style>
                                                    </Path>
                                                </Button>
                                                <Button Style="{StaticResource IconButton}" Click="OnEditClick" ToolTip="Изменить">
                                                    <Path Width="12" Height="12" Stretch="Uniform"
                                                          Stroke="{StaticResource MutedBrush}" StrokeThickness="1.4"
                                                          Data="M4,16 L4,20 H8 L18,10 L14,6 Z M13,7 L17,11"/>
                                                </Button>
                                                <Button Style="{StaticResource IconButton}" Click="OnDeleteClick" ToolTip="Удалить">
                                                    <Path Width="12" Height="12" Stretch="Uniform"
                                                          Stroke="{StaticResource MutedBrush}" StrokeThickness="1.4"
                                                          Data="M5,7 H19 M9,7 V5 H15 V7 M8,10 V18 M12,10 V18 M16,10 V18 M7,7 L8,20 H16 L17,7"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border x:Name="EmptyState"
                                    Visibility="Collapsed"
                                    Background="{StaticResource GlassBrush}"
                                    BorderBrush="{StaticResource HairlineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="24"
                                    Padding="32">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360">
                                    <TextBlock x:Name="EmptyTitle"
                                               Text="Буфер ещё пуст"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="EmptyHint"
                                               Text="Скопируйте текст в любой программе - он появится здесь. Нажмите на карточку, чтобы вернуть его в буфер."
                                               Margin="0,10,0,0"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                            </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
            </Grid>
        </Border>

        <!-- Editor overlay -->
        <Grid x:Name="EditorOverlay" Visibility="Collapsed" Background="#990B0D11"
              WindowChrome.IsHitTestVisibleInChrome="True">
            <Border x:Name="EditorCard" Width="560" MaxWidth="560"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="#E613161C"
                    BorderBrush="{StaticResource HairlineStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="22"
                    RenderTransformOrigin="0.5,0.42">
                <StackPanel>
                    <TextBlock x:Name="EditorTitle" Text="Новая запись" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Заголовок необязателен. Текст копируется целиком."
                               Margin="0,6,0,14"
                               Foreground="{StaticResource SubtleBrush}"/>
                    <TextBox x:Name="EditorName"
                             Style="{StaticResource FieldBox}"
                             Margin="0,0,0,10"/>
                    <TextBox x:Name="EditorBody"
                             Style="{StaticResource FieldBox}"
                             Height="180"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             FontFamily="{StaticResource UiFont}"/>
                    <TextBlock Text="Тип" Margin="2,14,0,6" FontSize="11" Foreground="{StaticResource SubtleBrush}"/>
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="KindClip" Style="{StaticResource ChipToggle}" Content="Фрагмент" Margin="0,0,6,0" Click="OnKindChip"/>
                        <ToggleButton x:Name="KindNote" Style="{StaticResource ChipToggle}" Content="Заметка" Margin="0,0,6,0" Click="OnKindChip"/>
                        <ToggleButton x:Name="KindCode" Style="{StaticResource ChipToggle}" Content="Код" Margin="0,0,6,0" Click="OnKindChip"/>
                        <ToggleButton x:Name="KindLink" Style="{StaticResource ChipToggle}" Content="Ссылка" Click="OnKindChip"/>
                    </StackPanel>
                    <TextBlock Text="Метка" Margin="2,14,0,6" FontSize="11" Foreground="{StaticResource SubtleBrush}"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Width="22" Height="22" Margin="0,0,8,0" Click="OnColorDot" Tag="none" ToolTip="Без метки">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="D" Width="18" Height="18" CornerRadius="9" Background="#55EEF1F5" BorderThickness="2" BorderBrush="Transparent"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="D" Property="BorderBrush" Value="#88D7DDE6"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="22" Height="22" Margin="0,0,8,0" Click="OnColorDot" Tag="sky" ToolTip="Небо">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="D" Width="18" Height="18" CornerRadius="9" Background="{StaticResource SkyBrush}" BorderThickness="2" BorderBrush="Transparent"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="D" Property="BorderBrush" Value="#EED7DDE6"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="22" Height="22" Margin="0,0,8,0" Click="OnColorDot" Tag="sage" ToolTip="Шалфей">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="D" Width="18" Height="18" CornerRadius="9" Background="{StaticResource SageBrush}" BorderThickness="2" BorderBrush="Transparent"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="22" Height="22" Margin="0,0,8,0" Click="OnColorDot" Tag="clay" ToolTip="Глина">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="D" Width="18" Height="18" CornerRadius="9" Background="{StaticResource ClayBrush}" BorderThickness="2" BorderBrush="Transparent"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Width="22" Height="22" Click="OnColorDot" Tag="sand" ToolTip="Песок">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="D" Width="18" Height="18" CornerRadius="9" Background="{StaticResource SandBrush}" BorderThickness="2" BorderBrush="Transparent"/>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="Папка" Margin="2,14,0,6" FontSize="11" Foreground="{StaticResource SubtleBrush}"/>
                    <ComboBox x:Name="EditorFolder"
                              Height="38"
                              Padding="10,6"
                              BorderBrush="{StaticResource HairlineBrush}"
                              Background="#1A13161C"
                              Foreground="{StaticResource FgBrush}">
                        <ComboBox.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#13161C"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#EEF1F5"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3AD7DDE6"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0B0D11"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#13161C"/>
                        </ComboBox.Resources>
                    </ComboBox>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                        <Button Style="{StaticResource GhostButton}" Content="Отмена" Padding="16,8" Click="OnEditorCancel"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Сохранить" Margin="8,0,0,0" Padding="18,8" Click="OnEditorSave"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="SettingsOverlay"
              Visibility="Collapsed"
              Background="#990B0D11"
              WindowChrome.IsHitTestVisibleInChrome="True">
            <Border x:Name="SettingsCard"
                    Width="460" MaxHeight="620"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="#F41A1D24"
                    BorderBrush="{StaticResource HairlineStrongBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    ClipToBounds="True"
                    RenderTransformOrigin="0.5,0.42">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="22,18,12,8">
                        <TextBlock Text="Настройки" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource IconButton}"
                                HorizontalAlignment="Right"
                                Width="36" Height="36"
                                Click="OnCloseSettings"
                                ToolTip="Закрыть"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                            <Path Width="9" Height="9" Stretch="Uniform"
                                  Stroke="{StaticResource MutedBrush}" StrokeThickness="1.6"
                                  Data="M1,1 L11,11 M11,1 L1,11"/>
                        </Button>
                    </Grid>
                    <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" Style="{StaticResource OverlayScroll}">
                        <StackPanel Margin="22,4,22,20">
                            <TextBlock Text="Окно" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubtleBrush}"/>
                            <CheckBox x:Name="SettingsAcrylic"
                                      Style="{StaticResource GlassCheck}"
                                      Margin="0,10,0,4"
                                      Content="Полупрозрачная подложка"
                                      Checked="OnThemeChanged"
                                      Unchecked="OnThemeChanged"/>
                            <TextBlock Text="Одинаковый layered-режим на Windows 10 и 11. Если выключить, подложка станет сплошной."
                                       FontSize="11" Foreground="{StaticResource SubtleBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <TextBlock Text="Цвет акцента" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubtleBrush}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Button Width="22" Height="22" Margin="0,0,8,0" Click="OnAccentDot" Tag="#D7DDE6" ToolTip="Светлый" Background="#D7DDE6" Style="{StaticResource ColorSwatch}"/>
                                <Button Width="22" Height="22" Margin="0,0,8,0" Click="OnAccentDot" Tag="#7AA2C4" ToolTip="Небо" Background="#7AA2C4" Style="{StaticResource ColorSwatch}"/>
                                <Button Width="22" Height="22" Margin="0,0,8,0" Click="OnAccentDot" Tag="#7A9A86" ToolTip="Шалфей" Background="#7A9A86" Style="{StaticResource ColorSwatch}"/>
                                <Button Width="22" Height="22" Margin="0,0,8,0" Click="OnAccentDot" Tag="#C48A7A" ToolTip="Глина" Background="#C48A7A" Style="{StaticResource ColorSwatch}"/>
                                <Button Width="22" Height="22" Margin="0,0,8,0" Click="OnAccentDot" Tag="#C4B49A" ToolTip="Песок" Background="#C4B49A" Style="{StaticResource ColorSwatch}"/>
                                <Button Width="22" Height="22" Click="OnAccentDot" Tag="#A89BC4" ToolTip="Лаванда" Background="#A89BC4" Style="{StaticResource ColorSwatch}"/>
                            </StackPanel>

                            <TextBlock Text="Цвет подложки" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubtleBrush}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Button Width="22" Height="22" Margin="0,0,8,0" Click="OnTintDot" Tag="#0B0D11" ToolTip="Ночь" Background="#0B0D11" Style="{StaticResource ColorSwatch}"/>
                                <Button Width="22" Height="22" Margin="0,0,8,0" Click="OnTintDot" Tag="#12151C" ToolTip="Графит" Background="#12151C" Style="{StaticResource ColorSwatch}"/>
                                <Button Width="22" Height="22" Margin="0,0,8,0" Click="OnTintDot" Tag="#0E1218" ToolTip="Чернила" Background="#0E1218" Style="{StaticResource ColorSwatch}"/>
                                <Button Width="22" Height="22" Click="OnTintDot" Tag="#16120E" ToolTip="Тёплый" Background="#16120E" Style="{StaticResource ColorSwatch}"/>
                            </StackPanel>

                            <TextBlock Text="Фон" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubtleBrush}"/>
                            <TextBlock Text="Своё фото растянется под окно. Размытие и затемнение подгоняют его под тёмный интерфейс."
                                       FontSize="11" Foreground="{StaticResource SubtleBrush}"
                                       TextWrapping="Wrap" Margin="0,6,0,10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Style="{StaticResource PrimaryButton}" Content="Выбрать фото" Click="OnPickWallpaper" Padding="12,7"/>
                                <Button Style="{StaticResource GhostButton}" Content="Убрать" Margin="8,0,0,0" Click="OnClearWallpaper" Padding="12,7"/>
                                <Button Style="{StaticResource GhostButton}" Content="Цвет из фото" Margin="8,0,0,0" Click="OnSampleWallpaper" Padding="12,7"/>
                            </StackPanel>
                            <TextBlock x:Name="SettingsPhotoName"
                                       Text="Фото не выбрано"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="Растяжение" FontSize="11" Foreground="{StaticResource SubtleBrush}" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <ToggleButton x:Name="StretchCover" Style="{StaticResource ChipToggle}" Content="Заполнить" Margin="0,0,6,0" Click="OnStretchChip"/>
                                <ToggleButton x:Name="StretchFill" Style="{StaticResource ChipToggle}" Content="Растянуть" Margin="0,0,6,0" Click="OnStretchChip"/>
                                <ToggleButton x:Name="StretchFit" Style="{StaticResource ChipToggle}" Content="Вписать" Click="OnStretchChip"/>
                            </StackPanel>

                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Размытие" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="SettingsBlurValue" Text="18" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource SubtleBrush}"/>
                            </Grid>
                            <Slider x:Name="SettingsBlur"
                                    Style="{StaticResource GlassSlider}"
                                    Minimum="0" Maximum="40"
                                    Value="18"
                                    ValueChanged="OnThemeSlider"/>

                            <Grid Margin="0,14,0,10">
                                <TextBlock Text="Затемнение" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                <TextBlock x:Name="SettingsDimValue" Text="58%" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource SubtleBrush}"/>
                            </Grid>
                            <Slider x:Name="SettingsDim"
                                    Style="{StaticResource GlassSlider}"
                                    Minimum="15" Maximum="88"
                                    Value="58"
                                    ValueChanged="OnThemeSlider"/>

                            <TextBlock Text="Обновления" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubtleBrush}" Margin="0,20,0,8"/>
                            <Button Style="{StaticResource NavButton}" Height="40" Click="OnCheckUpdates">
                                <TextBlock Text="Проверить обновления" HorizontalAlignment="Left"/>
                            </Button>

                            <Button Style="{StaticResource GhostButton}"
                                    HorizontalAlignment="Left"
                                    Margin="0,16,0,4"
                                    Padding="0,6"
                                    Click="OnResetTheme"
                                    Content="Сбросить оформление"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Border x:Name="UpdateCard"
                Visibility="Collapsed"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Width="312"
                Margin="0,58,16,0"
                Background="#F216191F"
                BorderBrush="{StaticResource HairlineStrongBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="16,14"
                Panel.ZIndex="40">
            <StackPanel>
                <Grid>
                    <TextBlock x:Name="UpdateTitle"
                               Text="Доступно обновление"
                               FontSize="14"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,32,0"/>
                    <Button Style="{StaticResource IconButton}"
                            HorizontalAlignment="Right"
                            Width="28" Height="28"
                            Click="OnUpdateDismiss"
                            ToolTip="Позже">
                        <Path Width="9" Height="9" Stretch="Uniform"
                              Stroke="{StaticResource MutedBrush}" StrokeThickness="1.6"
                              Data="M1,1 L11,11 M11,1 L1,11"/>
                    </Button>
                </Grid>
                <TextBlock x:Name="UpdateHint"
                           Margin="0,8,0,14"
                           FontSize="12"
                           LineHeight="18"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap"
                           Text="Новая версия готова. Клип обновится и откроется снова."/>
                <Button x:Name="UpdateButton"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Left"
                        MinWidth="112"
                        Click="OnUpdateApply"
                        Content="Обновить"/>
            </StackPanel>
        </Border>

        <Border x:Name="ToastHost"
                Visibility="Collapsed"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,28"
                Background="#F213161C"
                BorderBrush="{StaticResource HairlineStrongBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16,9"
                IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" Text="" Foreground="{StaticResource FgBrush}" FontSize="13"/>
        </Border>
    </Grid>
</Window>

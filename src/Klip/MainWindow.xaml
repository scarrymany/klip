<Window x:Class="Klip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Клип"
        Width="980" Height="640"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Foreground="{StaticResource FgBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="False">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="-1" />
  </WindowChrome.WindowChrome>

  <Border x:Name="Shell" Background="#CC0B0D11" CornerRadius="12" BorderBrush="#22EEF1F5" BorderThickness="1">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="228"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0" Margin="10">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,10,8,16">
          <Border Width="28" Height="28" CornerRadius="6" Background="{StaticResource PrimaryBrush}">
            <TextBlock Text="K" Foreground="{StaticResource PrimaryFgBrush}" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Клип" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock x:Name="CountLabel" Text="0 записей" Foreground="{StaticResource SubtleBrush}" FontSize="11"/>
          </StackPanel>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="4">
          <CheckBox x:Name="StartupBox" Content="Запускать с Windows" Foreground="{StaticResource MutedBrush}"
                    Margin="6,0,0,10" Checked="StartupBox_Changed" Unchecked="StartupBox_Changed"/>
          <TextBlock Text="Ctrl + Shift + V — показать" Foreground="{StaticResource SubtleBrush}" FontSize="11" Margin="6,0,0,8"/>
        </StackPanel>

        <StackPanel>
          <Button x:Name="NavAll" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Click="Nav_Click" Tag="all"
                  HorizontalContentAlignment="Left" Height="40" Padding="12,0" Content="Все"/>
          <Button Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Click="Nav_Click" Tag="pinned"
                  HorizontalContentAlignment="Left" Height="40" Padding="12,0" Content="Закреплённые"/>
          <Button Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Click="Nav_Click" Tag="clip"
                  HorizontalContentAlignment="Left" Height="40" Padding="12,0" Content="Фрагменты"/>
          <Button Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Click="Nav_Click" Tag="note"
                  HorizontalContentAlignment="Left" Height="40" Padding="12,0" Content="Заметки"/>
          <Button Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Click="Nav_Click" Tag="code"
                  HorizontalContentAlignment="Left" Height="40" Padding="12,0" Content="Код"/>
          <Button Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" Click="Nav_Click" Tag="link"
                  HorizontalContentAlignment="Left" Height="40" Padding="12,0" Content="Ссылки"/>
          <TextBlock Text="ПАПКИ" Foreground="{StaticResource SubtleBrush}" FontSize="11" Margin="12,16,0,6"/>
          <ItemsControl x:Name="FolderList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Content="{Binding Name}" Click="Folder_Click" Height="36"
                        HorizontalContentAlignment="Left" Background="Transparent"
                        Foreground="{StaticResource FgBrush}" BorderThickness="0" Padding="12,0"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <DockPanel Margin="4,8,4,0">
            <Button DockPanel.Dock="Right" Width="36" Height="32" Click="AddFolder_Click" Content="+"
                    Background="Transparent" Foreground="{StaticResource FgBrush}" BorderThickness="0"/>
            <TextBox x:Name="FolderNameBox" Height="32" Padding="8,6" Background="#14FFFFFF" Foreground="{StaticResource FgBrush}"
                     BorderThickness="0" CaretBrush="{StaticResource FgBrush}"/>
          </DockPanel>
        </StackPanel>
      </DockPanel>

      <Grid Grid.Column="1" Margin="0,10,10,10">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,10">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Width="40" Height="32" Click="Minimize_Click" Content="—" Background="Transparent"
                    Foreground="{StaticResource MutedBrush}" BorderThickness="0"/>
            <Button Width="40" Height="32" Click="Close_Click" Content="×" Background="Transparent"
                    Foreground="{StaticResource MutedBrush}" BorderThickness="0" FontSize="16"/>
          </StackPanel>
          <Border Background="#14FFFFFF" CornerRadius="10" MouseLeftButtonDown="Title_Drag">
            <DockPanel>
              <TextBox x:Name="SearchBox" Height="40" Margin="12,0,8,0" Background="Transparent"
                       Foreground="{StaticResource FgBrush}" BorderThickness="0" CaretBrush="{StaticResource FgBrush}"
                       VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"/>
            </DockPanel>
          </Border>
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,10">
          <Button DockPanel.Dock="Right" Content="Сохранить" Width="110" Height="36" Margin="8,0,0,0"
                  Click="SaveDraft_Click" Background="{StaticResource PrimaryBrush}" Foreground="{StaticResource PrimaryFgBrush}"
                  BorderThickness="0" FontWeight="SemiBold"/>
          <TextBox x:Name="DraftBox" MinHeight="72" AcceptsReturn="True" TextWrapping="Wrap"
                   Padding="12" Background="#14FFFFFF" Foreground="{StaticResource FgBrush}"
                   BorderThickness="0" CaretBrush="{StaticResource FgBrush}"
                   VerticalScrollBarVisibility="Auto"/>
        </DockPanel>

        <ListBox x:Name="ClipList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="ClipList_DoubleClick"
                 KeyDown="ClipList_KeyDown">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,8" Padding="14" CornerRadius="12" Background="#18FFFFFF">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Закр." Width="48" Height="28" Tag="{Binding Id}" Click="Pin_Click"
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    <Button Content="Удл." Width="40" Height="28" Tag="{Binding Id}" Click="Delete_Click"
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                  </StackPanel>
                  <StackPanel>
                    <DockPanel>
                      <TextBlock Text="{Binding KindLabel}" DockPanel.Dock="Right"
                                 Foreground="{StaticResource SubtleBrush}" FontSize="11"/>
                      <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="13"/>
                    </DockPanel>
                    <TextBlock Text="{Binding PreviewText}" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" MaxHeight="54" Margin="0,6,0,0"/>
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Grid>
  </Border>
</Window>

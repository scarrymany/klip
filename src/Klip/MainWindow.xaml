<Window x:Class="Klip.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:Klip.Models" xmlns:services="clr-namespace:Klip.Services" Title="Scarp Klip" Width="1100" Height="720" MinWidth="740" MinHeight="500" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" ResizeMode="CanResize" Background="Transparent" Foreground="{StaticResource FgBrush}" FontFamily="{StaticResource UiFont}" FontSize="13" SnapsToDevicePixels="True" UseLayoutRounding="True" Closing="OnClosing" SourceInitialized="OnSourceInitialized" SizeChanged="OnWindowSizeChanged" DpiChanged="OnWindowDpiChanged" PreviewKeyDown="OnPreviewKeyDown" StateChanged="OnStateChanged">
    <Window.Resources>
        <services:ImagePathConverter x:Key="ImagePathConverter" />
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="6" UseAeroCaptionButtons="False" NonClientFrameEdges="None" />
    </WindowChrome.WindowChrome>
    <Grid x:Name="AppSurface">
        <Border x:Name="WindowFrame" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" Background="{DynamicResource BgBrush}" CornerRadius="6" ClipToBounds="True">
            <Grid>
                <Image x:Name="WallpaperImage" Stretch="UniformToFill" Visibility="Collapsed" IsHitTestVisible="False" />
                <Border x:Name="WallpaperDim" Visibility="Collapsed" IsHitTestVisible="False" />
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
                        <Grid Margin="12,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="20" Height="20" CornerRadius="4" Background="#FFFFFF">
                                    <Path Fill="#000000" Data="M10,2 L4,11 H9 L7,18 L16,8 H11 L13,2 Z" Width="12" Height="14" Stretch="Uniform" />
                                </Border>
                                <TextBlock Text="SCARP KLIP" Foreground="#FFFFFF" Margin="10,0,0,0" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBlock x:Name="TitleCount" Margin="18,0,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource ChromeButton}" Click="OnOpenTelegram" ToolTip="Telegram @yeet17">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M23.91,3.79 L20.3,20.84 C20.03,22.05 19.32,22.35 18.31,21.78 L12.81,17.72 L10.16,20.27 C9.87,20.56 9.62,20.81 9.06,20.81 L9.45,15.21 L19.64,6 C20.08,5.61 19.54,5.39 18.96,5.78 L6.37,13.7 L0.95,12 C-0.23,11.63 -0.25,10.82 1.2,10.25 L22.37,2.1 C23.35,1.74 24.21,2.34 23.91,3.79 Z" Width="20" Height="20" Stretch="Uniform" />
                                </Button>
                                <Button Style="{StaticResource ChromeButton}" Click="OnOpenGitHub" ToolTip="Репозиторий на GitHub">
                                    <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Data="M12,0.5 C5.37,0.5 0,5.87 0,12.5 C0,17.8 3.44,22.3 8.21,23.89 C8.81,24 9.03,23.63 9.03,23.31 C9.03,23.02 9.02,22.28 9.02,21.29 C5.68,22.02 4.97,19.68 4.97,19.68 C4.42,18.28 3.63,17.91 3.63,17.91 C2.54,17.16 3.72,17.18 3.72,17.18 C4.93,17.27 5.56,18.42 5.56,18.42 C6.63,20.26 8.37,19.73 9.06,19.42 C9.17,18.64 9.48,18.11 9.82,17.81 C7.15,17.5 4.34,16.48 4.34,11.88 C4.34,10.57 4.81,9.5 5.58,8.66 C5.46,8.35 5.04,7.14 5.7,5.49 C5.7,5.49 6.71,5.17 9,6.72 C9.96,6.45 10.98,6.31 12,6.31 C13.02,6.31 14.04,6.45 15,6.72 C17.29,5.17 18.3,5.49 18.3,5.49 C18.96,7.14 18.54,8.35 18.42,8.66 C19.19,9.5 19.66,10.57 19.66,11.88 C19.66,16.49 16.84,17.49 14.16,17.8 C14.59,18.17 14.98,18.9 14.98,20.02 C14.98,21.62 14.97,22.91 14.97,23.31 C14.97,23.63 15.19,24.01 15.8,23.89 C20.56,22.3 24,17.8 24,12.5 C24,5.87 18.63,0.5 12,0.5 Z" Width="20" Height="20" Stretch="Uniform" />
                                </Button>
                                <Button Style="{StaticResource ChromeButton}" Click="OnMinimize" ToolTip="Свернуть">
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M4,10 H16" Width="20" Height="20" Stretch="None" />
                                </Button>
                                <Button x:Name="MaxButton" Style="{StaticResource ChromeButton}" Click="OnMaximize" ToolTip="Развернуть">
                                    <Path x:Name="MaxIcon" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Data="M5,5 H15 V15 H5 Z" Width="20" Height="20" Stretch="None" />
                                </Button>
                                <Button Style="{StaticResource CloseButton}" Click="OnCloseClick" ToolTip="Скрыть в трей">
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M5,5 L15,15 M15,5 L5,15" Width="20" Height="20" Stretch="None" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,1,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ScrollViewer x:Name="SideScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="20,20,16,18" Margin="0,0,0,14">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="36" Height="36" CornerRadius="8" Background="#FFFFFF">
                                                    <Path Fill="#000000" Data="M10,2 L4,11 H9 L7,18 L16,8 H11 L13,2 Z" Width="17" Height="22" Stretch="Uniform" />
                                                </Border>
                                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Scarp Klip" FontSize="19" FontWeight="Bold" Foreground="#FFFFFF" />
                                                    <TextBlock Text="Буфер обмена" FontSize="11" Foreground="{StaticResource SubtleBrush}" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Margin="12,0,12,16">
                                            <TextBlock Text="БИБЛИОТЕКА" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SubtleBrush}" Margin="14,0,0,10" />
                                            <Button x:Name="NavAll" Style="{StaticResource NavButton}" Click="OnNavClick" Tag="all" Margin="0,0,0,3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="Все записи" />
                                                    <TextBlock Grid.Column="2" x:Name="CountAll" Text="0" Foreground="{StaticResource SubtleBrush}" FontSize="12" />
                                                </Grid>
                                            </Button>
                                            <Button x:Name="NavPinned" Style="{StaticResource NavButton}" Click="OnNavClick" Tag="pinned" Margin="0,0,0,3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="Закреплённое" />
                                                    <TextBlock Grid.Column="2" x:Name="CountPinned" Text="0" Foreground="{StaticResource SubtleBrush}" FontSize="12" />
                                                </Grid>
                                            </Button>
                                            <Button x:Name="NavClip" Style="{StaticResource NavButton}" Click="OnNavClick" Tag="clip" Margin="0,0,0,3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="Фрагменты" />
                                                    <TextBlock Grid.Column="2" x:Name="CountClip" Text="0" Foreground="{StaticResource SubtleBrush}" FontSize="12" />
                                                </Grid>
                                            </Button>
                                            <Button x:Name="NavNote" Style="{StaticResource NavButton}" Click="OnNavClick" Tag="note" Margin="0,0,0,3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="Заметки" />
                                                    <TextBlock Grid.Column="2" x:Name="CountNote" Text="0" Foreground="{StaticResource SubtleBrush}" FontSize="12" />
                                                </Grid>
                                            </Button>
                                            <Button x:Name="NavCode" Style="{StaticResource NavButton}" Click="OnNavClick" Tag="code" Margin="0,0,0,3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="Код" />
                                                    <TextBlock Grid.Column="2" x:Name="CountCode" Text="0" Foreground="{StaticResource SubtleBrush}" FontSize="12" />
                                                </Grid>
                                            </Button>
                                            <Button x:Name="NavLink" Style="{StaticResource NavButton}" Click="OnNavClick" Tag="link" Margin="0,0,0,3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="Ссылки" />
                                                    <TextBlock Grid.Column="2" x:Name="CountLink" Text="0" Foreground="{StaticResource SubtleBrush}" FontSize="12" />
                                                </Grid>
                                            </Button>
                                            <Button x:Name="NavImage" Style="{StaticResource NavButton}" Click="OnNavClick" Tag="image" Margin="0,0,0,3">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="24" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="Изображения" />
                                                    <TextBlock Grid.Column="2" x:Name="CountImage" Text="0" Foreground="{StaticResource SubtleBrush}" FontSize="12" />
                                                </Grid>
                                            </Button>
                                            <TextBlock Text="ПАПКИ" Margin="14,20,0,8" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SubtleBrush}" />
                                            <ItemsControl x:Name="FolderList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:CollectionItem}">
                                                        <Grid Margin="0,1">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Button Click="OnFolderClick">
                                                                <Button.Style>
                                                                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                                <Setter Property="Tag" Value="active" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Button.Style>
                                                                <Grid>
                                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,28,0" />
                                                                    <TextBlock Text="{Binding Count}" HorizontalAlignment="Right" Foreground="{StaticResource SubtleBrush}" FontSize="12" />
                                                                </Grid>
                                                            </Button>
                                                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="28" Height="28" Click="OnDeleteFolder" ToolTip="Удалить папку">
                                                                <Path Width="11" Height="11" Stretch="Uniform" Stroke="{StaticResource SubtleBrush}" StrokeThickness="1.4" Data="M4,6 H20 M9,6 V4 H15 V6 M8,10 V18 M12,10 V18 M16,10 V18 M6,6 L7,20 H17 L18,6" />
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Grid Margin="4,6,4,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid>
                                                    <TextBox x:Name="FolderNameBox" Style="{StaticResource FieldBox}" Padding="10,7" Height="42" VerticalContentAlignment="Center" MaxLength="64" KeyDown="OnFolderNameKey" />
                                                    <TextBlock x:Name="FolderHint" Text="Новая папка" Foreground="{StaticResource SubtleBrush}" Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                                                </Grid>
                                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Width="36" Height="36" Margin="4,0,0,0" Click="OnAddFolder" ToolTip="Добавить папку">
                                                    <Path Width="11" Height="11" Stretch="Uniform" Stroke="{StaticResource FgBrush}" StrokeThickness="1.6" Data="M12,5 V19 M5,12 H19" />
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                                <Border Grid.Row="1" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="12,12,12,14">
                                    <StackPanel>
                                        <CheckBox x:Name="StartupCheck" Style="{StaticResource GlassCheck}" Margin="14,0,0,10" Content="Запускать с Windows" Checked="OnStartupChanged" Unchecked="OnStartupChanged" />
                                        <Button x:Name="SettingsButton" Style="{StaticResource NavButton}" Click="OnOpenSettings">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" Margin="0,0,11,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Настройки" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock x:Name="VersionLabel" Margin="14,9,0,0" FontSize="11" Foreground="{StaticResource SubtleBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <Grid Grid.Column="1" Margin="26,22,26,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock x:Name="PageTitle" Text="Все записи" FontSize="21" FontWeight="Bold" Foreground="#FFFFFF" />
                                <TextBlock Text="Текст, ссылки и изображения всегда под рукой." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource GlassBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="4" Padding="12,0" Height="42">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Path Stroke="{StaticResource SubtleBrush}" StrokeThickness="1.5" Fill="Transparent" Data="M10,3 A7,7 0 1 1 10,17 A7,7 0 1 1 10,3 Z M15.5,15.5 L20,20" Width="15" Height="15" Stretch="Uniform" Margin="0,0,11,0" />
                                        <Grid Grid.Column="1">
                                            <TextBlock x:Name="SearchHint" Text="Поиск по записям" Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center" IsHitTestVisible="False" />
                                            <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" VerticalAlignment="Center" TextChanged="OnSearchChanged" AutomationProperties.Name="Поиск по записям" />
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Button x:Name="NewNoteButton" Grid.Column="1" Style="{StaticResource PrimaryButton}" Margin="12,0,0,0" Height="42" Click="OnNewNote" Content="Новая запись" />
                            </Grid>
                            <Grid x:Name="ClipStage" Grid.Row="2" ClipToBounds="True">
                                <Grid x:Name="ClipPane">
                                    <ListBox x:Name="ClipList" ItemsSource="{Binding VisibleClips}" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True" PreviewMouseLeftButtonDown="OnClipClick" KeyDown="OnListKeyDown">
                                        <ListBox.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Копировать" Click="OnCopyMenu" />
                                                <MenuItem Header="Закрепить" Click="OnPinMenu" />
                                                <MenuItem Header="Изменить" Click="OnEditMenu" />
                                                <MenuItem Header="Цвет">
                                                    <MenuItem Header="Без метки" Tag="none" Click="OnColorMenu" />
                                                    <MenuItem Header="Небо" Tag="sky" Click="OnColorMenu" />
                                                    <MenuItem Header="Шалфей" Tag="sage" Click="OnColorMenu" />
                                                    <MenuItem Header="Глина" Tag="clay" Click="OnColorMenu" />
                                                    <MenuItem Header="Песок" Tag="sand" Click="OnColorMenu" />
                                                </MenuItem>
                                                <MenuItem x:Name="FolderMenu" Header="Папка" />
                                                <Separator />
                                                <MenuItem Header="Удалить" Click="OnDeleteMenu" />
                                            </ContextMenu>
                                        </ListBox.ContextMenu>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:ClipItem}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="3" CornerRadius="2" Background="{Binding MarkBrush}" Margin="0,2,12,2" />
                                                    <StackPanel Grid.Column="1">
                                                        <Border x:Name="ImageThumbnail" Visibility="Collapsed" Height="150" Margin="0,0,8,10" CornerRadius="4" Background="{DynamicResource BgBrush}" ClipToBounds="True">
                                                            <Image Source="{Binding ImagePath, Converter={StaticResource ImagePathConverter}, ConverterParameter=480}" Stretch="Uniform" />
                                                        </Border>
                                                        <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                            <Border Style="{StaticResource KindChip}">
                                                                <TextBlock Text="{Binding KindLabel}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                                            </Border>
                                                            <TextBlock Text="{Binding MetaLabel}" Margin="10,0,0,0" FontSize="11" Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Preview}" Margin="0,8,8,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="58" LineHeight="18">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                                                                    <Setter Property="FontSize" Value="13" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCode}" Value="True">
                                                                            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                                                                            <Setter Property="FontSize" Value="12" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                                        <Button Style="{StaticResource IconButton}" Click="OnPinClick" ToolTip="Закрепить">
                                                            <Path Width="12" Height="12" Stretch="Uniform" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.2" Data="M12 2 L15 8 L21.5 9 L16.8 13.6 L18 20 L12 16.8 L6 20 L7.2 13.6 L2.5 9 L9 8 Z">
                                                                <Path.Style>
                                                                    <Style TargetType="Path">
                                                                        <Setter Property="Fill" Value="Transparent" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Pinned}" Value="True">
                                                                                <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                                                <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                        </Button>
                                                        <Button x:Name="EditItemButton" Style="{StaticResource IconButton}" Click="OnEditClick" ToolTip="Изменить">
                                                            <Path Width="12" Height="12" Stretch="Uniform" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.4" Data="M4,16 L4,20 H8 L18,10 L14,6 Z M13,7 L17,11" />
                                                        </Button>
                                                        <Button Style="{StaticResource IconButton}" Click="OnDeleteClick" ToolTip="Удалить">
                                                            <Path Width="12" Height="12" Stretch="Uniform" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.4" Data="M5,7 H19 M9,7 V5 H15 V7 M8,10 V18 M12,10 V18 M16,10 V18 M7,7 L8,20 H16 L17,7" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                        <Setter TargetName="ImageThumbnail" Property="Visibility" Value="Visible" />
                                                        <Setter TargetName="EditItemButton" Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Border x:Name="EmptyState" Visibility="Collapsed" Background="{StaticResource GlassBrush}" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1" CornerRadius="6" Padding="24">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360">
                                            <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{StaticResource SubtleBrush}" HorizontalAlignment="Center" Margin="0,0,0,16" />
                                            <TextBlock x:Name="EmptyTitle" Text="Буфер ещё пуст" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                            <TextBlock x:Name="EmptyHint" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                            <Border Grid.Row="3" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,8,0,0">
                                <TextBlock Text="Ctrl + Shift + V  ·  Открыть буфер     Enter  ·  Копировать" FontSize="11" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
        <Grid x:Name="EditorOverlay" Visibility="Collapsed" Background="#B3000000" Margin="0,38,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
            <Border x:Name="EditorCard" Width="560" MaxHeight="630" VerticalAlignment="Stretch" HorizontalAlignment="Center" Margin="20,22" Background="{StaticResource GlassBrush}" BorderBrush="{StaticResource HairlineStrongBrush}" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="20,16">
                        <Grid>
                            <TextBlock x:Name="EditorTitle" Text="Новая запись" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Click="OnEditorCancel" ToolTip="Закрыть">
                                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" />
                            </Button>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" Style="{StaticResource OverlayScroll}">
                        <StackPanel Margin="20,16,20,20">
                            <TextBlock Text="Заголовок необязателен. Текст копируется целиком." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />
                            <TextBox x:Name="EditorName" Style="{StaticResource FieldBox}" Margin="0,0,0,10" />
                            <TextBox x:Name="EditorBody" Style="{StaticResource FieldBox}" Height="180" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="{StaticResource UiFont}" />
                            <TextBlock Text="Тип" Margin="2,14,0,6" FontSize="11" Foreground="{StaticResource SubtleBrush}" />
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="KindClip" Style="{StaticResource ChipToggle}" Content="Фрагмент" Margin="0,0,6,0" Click="OnKindChip" />
                                <ToggleButton x:Name="KindNote" Style="{StaticResource ChipToggle}" Content="Заметка" Margin="0,0,6,0" Click="OnKindChip" />
                                <ToggleButton x:Name="KindCode" Style="{StaticResource ChipToggle}" Content="Код" Margin="0,0,6,0" Click="OnKindChip" />
                                <ToggleButton x:Name="KindLink" Style="{StaticResource ChipToggle}" Content="Ссылка" Click="OnKindChip" />
                            </StackPanel>
                            <TextBlock Text="Метка" Margin="2,14,0,6" FontSize="11" Foreground="{StaticResource SubtleBrush}" />
                            <StackPanel Orientation="Horizontal">
                                <Button Width="22" Height="22" Margin="0,0,8,0" Click="OnColorDot" Tag="none" ToolTip="Без метки">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="D" Width="18" Height="18" CornerRadius="9" Background="#55EEF1F5" BorderThickness="2" BorderBrush="Transparent" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="D" Property="BorderBrush" Value="#88D7DDE6" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Width="22" Height="22" Margin="0,0,8,0" Click="OnColorDot" Tag="sky" ToolTip="Небо">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="D" Width="18" Height="18" CornerRadius="9" Background="{StaticResource SkyBrush}" BorderThickness="2" BorderBrush="Transparent" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="D" Property="BorderBrush" Value="#EED7DDE6" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Width="22" Height="22" Margin="0,0,8,0" Click="OnColorDot" Tag="sage" ToolTip="Шалфей">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="D" Width="18" Height="18" CornerRadius="9" Background="{StaticResource SageBrush}" BorderThickness="2" BorderBrush="Transparent" />
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Width="22" Height="22" Margin="0,0,8,0" Click="OnColorDot" Tag="clay" ToolTip="Глина">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="D" Width="18" Height="18" CornerRadius="9" Background="{StaticResource ClayBrush}" BorderThickness="2" BorderBrush="Transparent" />
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Width="22" Height="22" Click="OnColorDot" Tag="sand" ToolTip="Песок">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="D" Width="18" Height="18" CornerRadius="9" Background="{StaticResource SandBrush}" BorderThickness="2" BorderBrush="Transparent" />
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="Папка" Margin="2,14,0,6" FontSize="11" Foreground="{StaticResource SubtleBrush}" />
                            <ComboBox x:Name="EditorFolder" Style="{StaticResource ScarpComboBox}" Height="42" Padding="10,6" BorderBrush="{StaticResource HairlineBrush}" Background="{StaticResource GlassBrush}" Foreground="{StaticResource FgBrush}">
                                <ComboBox.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#141414" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#D4D4D4" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#1A1A1A" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0A0A0A" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#141414" />
                                </ComboBox.Resources>
                            </ComboBox>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="2" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="20,14">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButton}" Content="Отмена" Padding="16,8" Click="OnEditorCancel" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Сохранить" Margin="8,0,0,0" Padding="18,8" Click="OnEditorSave" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="SettingsOverlay" Visibility="Collapsed" Background="#B3000000" Margin="0,38,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
            <Border x:Name="SettingsCard" Width="480" MaxHeight="620" VerticalAlignment="Stretch" HorizontalAlignment="Center" Margin="20,22" Background="{StaticResource GlassBrush}" BorderBrush="{StaticResource HairlineStrongBrush}" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="20,16">
                        <Grid>
                            <TextBlock Text="Настройки" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Click="OnCloseSettings" ToolTip="Закрыть">
                                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" />
                            </Button>
                        </Grid>
                    </Border>
                    <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" Style="{StaticResource OverlayScroll}">
                        <StackPanel Margin="20,16,20,20">
                            <TextBlock Text="Окно" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubtleBrush}" />
                            <CheckBox x:Name="SettingsAcrylic" Style="{StaticResource GlassCheck}" Margin="0,10,0,4" Content="Полупрозрачная подложка" Checked="OnThemeChanged" Unchecked="OnThemeChanged" />
                            <TextBlock Text="Одинаковый layered-режим на Windows 10 и 11. Если выключить, подложка станет сплошной." FontSize="11" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />
                            <TextBlock Text="Цвет акцента" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubtleBrush}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Button Width="22" Height="22" Margin="0,0,8,0" Click="OnAccentDot" Tag="#FFFFFF" ToolTip="Светлый" Background="#FFFFFF" Style="{StaticResource ColorSwatch}" />
                                <Button Width="22" Height="22" Margin="0,0,8,0" Click="OnAccentDot" Tag="#7AA2C4" ToolTip="Небо" Background="#7AA2C4" Style="{StaticResource ColorSwatch}" />
                                <Button Width="22" Height="22" Margin="0,0,8,0" Click="OnAccentDot" Tag="#7A9A86" ToolTip="Шалфей" Background="#7A9A86" Style="{StaticResource ColorSwatch}" />
                                <Button Width="22" Height="22" Margin="0,0,8,0" Click="OnAccentDot" Tag="#C48A7A" ToolTip="Глина" Background="#C48A7A" Style="{StaticResource ColorSwatch}" />
                                <Button Width="22" Height="22" Margin="0,0,8,0" Click="OnAccentDot" Tag="#C4B49A" ToolTip="Песок" Background="#C4B49A" Style="{StaticResource ColorSwatch}" />
                                <Button Width="22" Height="22" Click="OnAccentDot" Tag="#A89BC4" ToolTip="Лаванда" Background="#A89BC4" Style="{StaticResource ColorSwatch}" />
                            </StackPanel>
                            <TextBlock Text="Цвет подложки" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubtleBrush}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Button Width="22" Height="22" Margin="0,0,8,0" Click="OnTintDot" Tag="#0A0A0A" ToolTip="Ночь" Background="#0A0A0A" Style="{StaticResource ColorSwatch}" />
                                <Button Width="22" Height="22" Margin="0,0,8,0" Click="OnTintDot" Tag="#12151C" ToolTip="Графит" Background="#12151C" Style="{StaticResource ColorSwatch}" />
                                <Button Width="22" Height="22" Margin="0,0,8,0" Click="OnTintDot" Tag="#0E1218" ToolTip="Чернила" Background="#0E1218" Style="{StaticResource ColorSwatch}" />
                                <Button Width="22" Height="22" Click="OnTintDot" Tag="#16120E" ToolTip="Тёплый" Background="#16120E" Style="{StaticResource ColorSwatch}" />
                            </StackPanel>
                            <TextBlock Text="Фон" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubtleBrush}" />
                            <TextBlock Text="Своё фото растянется под окно. Размытие и затемнение подгоняют его под тёмный интерфейс." FontSize="11" Foreground="{StaticResource SubtleBrush}" TextWrapping="Wrap" Margin="0,6,0,10" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Style="{StaticResource PrimaryButton}" Content="Выбрать фото" Click="OnPickWallpaper" Padding="12,7" />
                                <Button Style="{StaticResource GhostButton}" Content="Убрать" Margin="8,0,0,0" Click="OnClearWallpaper" Padding="12,7" />
                                <Button Style="{StaticResource GhostButton}" Content="Цвет из фото" Margin="8,0,0,0" Click="OnSampleWallpaper" Padding="12,7" />
                            </StackPanel>
                            <TextBlock x:Name="SettingsPhotoName" Text="Фото не выбрано" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12" />
                            <TextBlock Text="Растяжение" FontSize="11" Foreground="{StaticResource SubtleBrush}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <ToggleButton x:Name="StretchCover" Style="{StaticResource ChipToggle}" Content="Заполнить" Margin="0,0,6,0" Click="OnStretchChip" />
                                <ToggleButton x:Name="StretchFill" Style="{StaticResource ChipToggle}" Content="Растянуть" Margin="0,0,6,0" Click="OnStretchChip" />
                                <ToggleButton x:Name="StretchFit" Style="{StaticResource ChipToggle}" Content="Вписать" Click="OnStretchChip" />
                            </StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Размытие" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock x:Name="SettingsBlurValue" Text="18" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource SubtleBrush}" />
                            </Grid>
                            <Slider x:Name="SettingsBlur" Style="{StaticResource GlassSlider}" Minimum="0" Maximum="40" Value="18" ValueChanged="OnThemeSlider" />
                            <Grid Margin="0,14,0,10">
                                <TextBlock Text="Затемнение" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock x:Name="SettingsDimValue" Text="58%" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource SubtleBrush}" />
                            </Grid>
                            <Slider x:Name="SettingsDim" Style="{StaticResource GlassSlider}" Minimum="15" Maximum="88" Value="58" ValueChanged="OnThemeSlider" />
                            <TextBlock Text="Обновления" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SubtleBrush}" Margin="0,20,0,8" />
                            <Button Style="{StaticResource NavButton}" Height="40" Click="OnCheckUpdates">
                                <TextBlock Text="Проверить обновления" HorizontalAlignment="Left" />
                            </Button>
                            <TextBlock Text="Scarp Klip · Inter" FontSize="11" Foreground="{StaticResource SubtleBrush}" Margin="0,20,0,8" />
                            <ToggleButton x:Name="FontLicenseToggle" Style="{StaticResource ChipToggle}" Content="Лицензия шрифта Inter" HorizontalAlignment="Left" Click="OnFontLicense" />
                            <TextBox x:Name="FontLicenseText" Style="{StaticResource FieldBox}" Visibility="Collapsed" IsReadOnly="True" Height="200" Margin="0,10,0,0" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="11" AutomationProperties.Name="SIL Open Font License for Inter" />
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="2" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="20,14">
                        <Grid>
                            <Button Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="OnResetTheme" Content="Сбросить оформление" />
                            <Button Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="OnCloseSettings" Content="Готово" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="ImagePreviewOverlay" Visibility="Collapsed" Background="#CC000000" Margin="0,38,0,0" WindowChrome.IsHitTestVisibleInChrome="True">
            <Border x:Name="ImagePreviewCard" MaxWidth="760" MaxHeight="600" Margin="28,22" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="{StaticResource GlassBrush}" BorderBrush="{StaticResource HairlineStrongBrush}" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1" Padding="20,16">
                        <Grid>
                            <StackPanel Margin="0,0,36,0">
                                <TextBlock Text="Изображение" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock x:Name="ImagePreviewMeta" Margin="0,5,0,0" FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="OnImagePreviewClose" ToolTip="Закрыть">
                                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" />
                            </Button>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Margin="20,16" Background="{DynamicResource BgBrush}" CornerRadius="4" ClipToBounds="True">
                        <Image x:Name="ImagePreview" Stretch="Uniform" />
                    </Border>
                    <Border Grid.Row="2" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Padding="20,14">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButton}" Content="Сохранить как" Click="OnImageSaveAs" />
                            <Button Style="{StaticResource PrimaryButton}" Content="Копировать" Margin="8,0,0,0" Click="OnImagePreviewCopy" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <Border x:Name="UpdateCard" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Width="312" Margin="0,54,16,0" Background="{StaticResource GlassBrush}" BorderBrush="{StaticResource HairlineStrongBrush}" BorderThickness="1" CornerRadius="6" Padding="20,16" Panel.ZIndex="40">
            <StackPanel>
                <Grid>
                    <TextBlock x:Name="UpdateTitle" Text="Доступно обновление" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,32,0" />
                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" Width="28" Height="28" Click="OnUpdateDismiss" ToolTip="Позже">
                        <TextBlock Text="" FontFamily="Segoe MDL2 Assets" />
                    </Button>
                </Grid>
                <TextBlock x:Name="UpdateHint" Margin="0,8,0,14" FontSize="12" LineHeight="18" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                <Button x:Name="UpdateButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" MinWidth="112" Click="OnUpdateApply" Content="Обновить" />
            </StackPanel>
        </Border>
        <Border x:Name="ToastHost" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="20,0,20,28" Background="{StaticResource GlassBrush}" BorderBrush="{StaticResource HairlineStrongBrush}" BorderThickness="1" CornerRadius="6" Padding="16,10" IsHitTestVisible="False" Panel.ZIndex="50">
            <TextBlock x:Name="ToastText" Foreground="{StaticResource FgBrush}" FontSize="13" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
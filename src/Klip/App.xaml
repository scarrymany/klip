<Application x:Class="Klip.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="BgBrush" Color="#0B0D11"/>
    <SolidColorBrush x:Key="FgBrush" Color="#EEF1F5"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#8B929C"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="#6A717C"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#D7DDE6"/>
    <SolidColorBrush x:Key="PrimaryFgBrush" Color="#0B0D11"/>
    <SolidColorBrush x:Key="CardBrush" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#18FFFFFF"/>
    <SolidColorBrush x:Key="LineBrush" Color="#1AEEF1F5"/>
    <FontFamily x:Key="UiFont">Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>
  </Application.Resources>
</Application>
